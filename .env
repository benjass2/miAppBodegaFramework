# Copia este archivo como ".env" en la raíz del proyecto y completa
# con los valores reales de tu proyecto Supabase
# (Supabase Dashboard → Project Settings → API).
#
# El prefijo VITE_ es obligatorio: Vite solo expone al navegador
# las variables que empiezan así.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Mientras migras, puedes alternar entre el mock y Supabase sin
# tocar código: "mock" o "supabase".
VITE_DATA_SOURCE=mock
